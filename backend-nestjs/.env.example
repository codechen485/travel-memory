# ===== 数据库（与 docker-compose.yml 中的 PostgreSQL 对应，本地开发默认即可）=====
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/xingnang?schema=public"

# ===== JWT（至少 32 字符；生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）=====
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="24h"

# ===== Web / uploads =====
FRONTEND_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"

# ===== Redis 缓存（可选）=====
# 起 docker-compose 后即生效；不启动 Redis，后端会自动降级为直查数据库，接口照常不报错。
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== DeepSeek AI 文案（可选，去 https://platform.deepseek.com 申请）=====
# 留空则文案生成功能优雅降级返回 503，其余功能不受影响。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
